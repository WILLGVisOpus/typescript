# ==============================================
# ZITADEL LOGIN THEME CONFIGURATION (VisOpus fork)
# ==============================================
# This file documents all theme env vars consumed by src/lib/theme.ts.
# VisOpus production values are baked into .env.prod and the Cloud Run service.

# Theme Roundness Options
# ----------------------
# Controls the border radius of UI elements
# Options: "edgy" | "mid" | "full"
# - edgy: Sharp corners (rounded-none)
# - mid: Medium rounded corners (rounded-md/rounded-lg, ~6-8px) — VisOpus default
# - full: Fully rounded corners (rounded-full)
NEXT_PUBLIC_THEME_ROUNDNESS=mid

# Layout Options
# --------------
# Controls the overall layout structure
# Options: "side-by-side" | "top-to-bottom"
# - side-by-side: Brand section on left, form on right (desktop)
# - top-to-bottom: Brand section on top, form below — VisOpus default
NEXT_PUBLIC_THEME_LAYOUT=top-to-bottom

# Spacing Options
# ---------------
# Controls spacing and padding throughout the interface
# Options: "regular" | "compact"
NEXT_PUBLIC_THEME_SPACING=regular

# Appearance Options
# ------------------
# Complete design philosophies
# Options: "flat" | "material"
# - flat: Minimal flat design — VisOpus default
# - material: Material Design with elevated cards
NEXT_PUBLIC_THEME_APPEARANCE=flat

# Background Image
# ---------------
# Optional background image. Leave unset for solid background colour.
# NEXT_PUBLIC_THEME_BACKGROUND_IMAGE=

# ==============================================
# VISOPUS REBRAND NOTES
# ==============================================
# Brand colours, fonts, and logo are baked into the fork:
#   - src/helpers/colors.ts        — primary navy #0a1628, dark amber #f59e0b
#   - src/app/(login)/layout.tsx   — Noto Sans + Noto Sans Mono via next/font/google
#   - public/icon.svg              — navy + amber V mark
#   - public/email-logo-*.png      — email header/footer wordmarks
#
# Runtime overrides flow from Zitadel BrandingSettings (admin UI / management API)
# via src/helpers/colors.ts:setTheme(). Admin overrides take precedence over fallbacks.
